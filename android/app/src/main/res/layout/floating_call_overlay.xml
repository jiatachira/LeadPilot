<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_pill_root"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/floating_call_pill_bg"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:elevation="12dp">

    <!-- Status Indicator Dot -->
    <View
        android:id="@+id/floating_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/floating_call_status_dot" />

    <!-- Name & Status / Timer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/floating_caller_name"
            android:layout_width="wrap_content"
            android:maxWidth="130dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Calling..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/floating_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Audio Route Toggle (Speaker / Bluetooth / Earpiece) -->
    <ImageButton
        android:id="@+id/floating_btn_audio"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/incall_btn_circle"
        android:src="@drawable/ic_incall_speaker"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Audio Route" />

    <!-- End Call Button -->
    <ImageButton
        android:id="@+id/floating_btn_end"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/incall_btn_decline"
        android:src="@drawable/ic_incall_call_end"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="End Call" />

</LinearLayout>
