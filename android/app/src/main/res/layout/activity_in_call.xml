<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B131E"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="36dp">

    <!-- Top Header: Brand + Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_leadpilot"
            android:contentDescription="LeadPilot" />

        <TextView
            android:id="@+id/incall_header_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="LeadPilot Phone"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incall_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/caller_id_status_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Student Lead"
            android:textColor="#62D6B0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Caller Identity Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/incall_avatar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/incall_avatar_bg"
            android:gravity="center"
            android:text="LP"
            android:textColor="#48BE9A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incall_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Unknown Caller"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incall_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="077 123 4567"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/incall_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling..."
            android:textColor="#48BE9A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Student CRM Context Card -->
    <LinearLayout
        android:id="@+id/incall_student_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/incall_context_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/incall_student_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2026 A/L • Colombo"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incall_student_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3x No Answer"
                android:textColor="#FFAA48"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/incall_student_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Last comment..."
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Call Waiting / Secondary Call Banner -->
    <LinearLayout
        android:id="@+id/incall_secondary_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/incall_context_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/incall_secondary_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incoming Call"
                android:textColor="#48BE9A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incall_secondary_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0770000000"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/incall_btn_secondary_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/incall_btn_answer"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Swap"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incall_btn_secondary_reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/incall_btn_decline"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="End"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Controls Grid (Active / Dialing / Hold) -->
    <LinearLayout
        android:id="@+id/incall_controls_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Mute -->
            <LinearLayout
                android:id="@+id/btn_wrap_mute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_mute"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Mute"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_mic" />

                <TextView
                    android:id="@+id/incall_lbl_mute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mute"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Keypad -->
            <LinearLayout
                android:id="@+id/btn_wrap_keypad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_keypad"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Keypad"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_dialpad" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Keypad"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Speaker / Audio -->
            <LinearLayout
                android:id="@+id/btn_wrap_speaker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_speaker"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Speaker"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_speaker" />

                <TextView
                    android:id="@+id/incall_lbl_speaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Speaker"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Hold -->
            <LinearLayout
                android:id="@+id/btn_wrap_hold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_hold"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Hold"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_pause" />

                <TextView
                    android:id="@+id/incall_lbl_hold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Hold"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Open LeadPilot -->
            <LinearLayout
                android:id="@+id/btn_wrap_open_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_open_app"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Open LeadPilot"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_open_app" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LeadPilot"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bluetooth / Audio Route -->
            <LinearLayout
                android:id="@+id/btn_wrap_audio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_audio"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/incall_btn_circle"
                    android:contentDescription="Bluetooth"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_bluetooth" />

                <TextView
                    android:id="@+id/incall_lbl_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bluetooth"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- DTMF Keypad Overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/incall_dtmf_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/incall_context_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/incall_dtmf_digits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incall_btn_hide_keypad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Hide"
                android:textColor="#48BE9A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/incall_dtmf_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Bottom Call Actions -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Incoming Call Answer / Decline -->
        <LinearLayout
            android:id="@+id/incall_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_decline"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/incall_btn_decline"
                    android:contentDescription="Decline"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="#FCA5A5"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/incall_btn_answer"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/incall_btn_answer"
                    android:contentDescription="Answer"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_incall_call" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Answer"
                    android:textColor="#6EE7B7"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active / Dialing End Call -->
        <LinearLayout
            android:id="@+id/incall_active_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/incall_btn_end"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/incall_btn_decline"
                android:contentDescription="End Call"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_incall_call_end" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
